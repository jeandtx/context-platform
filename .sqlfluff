[sqlfluff]
# DuckDB dialect
dialect = duckdb

# Maximum line length
max_line_length = 100

# Indentation
indent_unit = space
indent_size = 2

# Template handling (for dbt)
templater = jinja

[sqlfluff:templater:jinja]
apply_dbt_macros = true
context = {}

[sqlfluff:templater:jinja:context]
# Add any Jinja context variables here if needed
# var_name = "value"

[sqlfluff:rules]
# Allow longer lines for complex queries
max_line_length = 100

# Spacing rules
comma_style = trailing

# dbt-specific rules
allow_scalar = false

# Exclusions
[sqlfluff:indentation]
indent_unit = space
tab_space_size = 2

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = consistent

[sqlfluff:rules:layout.type]
spacing_before = touch
spacing_after = single
